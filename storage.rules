rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /userFeedback/{userId}/{fileName} {
      // Allow everyone to read approved feedback images
      allow read: if true;
      
      // Allow users to upload their own feedback profile pictures
      // Enforce 5MB limit and image-only content types
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/external_certificates/{fileName} {
      // Allow users to read and write their own external certificates
      allow read, write: if request.auth != null && request.auth.uid == userId
                         && request.resource.size < 5 * 1024 * 1024
                         && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
