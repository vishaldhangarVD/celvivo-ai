{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account details and aggregate performance metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "founder"] },
        "credits": {
          "type": "object",
          "properties": {
            "aptitude": { "type": "number", "default": 0 },
            "coding": { "type": "number", "default": 0 },
            "interview": { "type": "number", "default": 0 }
          }
        },
        "subscription": {
          "type": "object",
          "properties": {
            "plan": { "type": "string", "enum": ["starter", "pro", null] },
            "status": { "type": "string", "enum": ["active", "inactive"] },
            "nextResetDate": { "type": "string", "format": "date-time" },
            "usage": {
              "type": "object",
              "properties": {
                "aptitude": { "type": "number", "default": 0 },
                "coding": { "type": "number", "default": 0 },
                "interview": { "type": "number", "default": 0 }
              }
            }
          }
        },
        "isFreeAccess": { "type": "boolean", "default": false },
        "resumeScore": { "type": "number" },
        "totalInterviews": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Stores user profile, credits, and subscription status."
    }
  }
}