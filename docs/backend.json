
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account details and aggregate performance metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "founder"], "description": "System access level. 'founder' grants console access." },
        "jobReadinessScore": { "type": "number" },
        "resumeScore": { "type": "number" },
        "totalInterviews": { "type": "number" },
        "currentStreak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "lastChallengeDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "InterviewSession": {
      "title": "Interview Session",
      "description": "A single mock interview attempt with transcript and feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "round": { "type": "string" },
        "overallScore": { "type": "number" },
        "technicalScore": { "type": "number" },
        "communicationScore": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "history": { "type": "array" },
        "feedback": { "type": "object" },
        "duration": { "type": "number" },
        "hiringRecommendation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ResumeAudit": {
      "title": "Resume Audit",
      "description": "Results of a neural resume intelligence scan.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "filename": { "type": "string" },
        "targetRole": { "type": "string" },
        "atsScore": { "type": "number" },
        "missingSkills": { "type": "array", "items": { "type": "string" } },
        "analysis": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "A tracked job mission node.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "companyName": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string", "enum": ["Applied", "Shortlisted", "Interview Scheduled", "Rejected", "Selected"] },
        "appliedDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DailyChallenge": {
      "title": "Daily Challenge",
      "description": "A single daily question attempt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "score": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Stores user profile and aggregate stats."
    },
    "/users/{userId}/interviews/{interviewId}": {
      "schema": "#/entities/InterviewSession",
      "description": "Stores individual mock interview records."
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "#/entities/ResumeAudit",
      "description": "Stores resume intelligence audits."
    },
    "/users/{userId}/job_applications/{appId}": {
      "schema": "#/entities/JobApplication",
      "description": "Stores tracked job application nodes."
    },
    "/users/{userId}/daily_challenges/{challengeId}": {
      "schema": "#/entities/DailyChallenge",
      "description": "Stores individual daily challenge records."
    }
  }
}
