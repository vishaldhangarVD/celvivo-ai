
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account details and aggregate performance metrics.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "jobReadinessScore": { "type": "number" },
        "resumeScore": { "type": "number" },
        "totalInterviews": { "type": "number" },
        "currentStreak": { "type": "number" },
        "bestStreak": { "type": "number" },
        "lastChallengeDate": { "type": "string" },
        "missingSkills": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "InterviewSession": {
      "title": "Interview Session",
      "description": "A single mock interview attempt with transcript and feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "overallScore": { "type": "number" },
        "technicalScore": { "type": "number" },
        "communicationScore": { "type": "number" },
        "confidenceScore": { "type": "number" },
        "history": { "type": "array" },
        "feedback": { "type": "object" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DailyChallenge": {
      "title": "Daily Challenge",
      "description": "A single daily question attempt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "question": { "type": "string" },
        "type": { "type": "string" },
        "answer": { "type": "string" },
        "score": { "type": "number" },
        "feedback": { "type": "string" },
        "tips": { "type": "array", "items": { "type": "string" } },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ResumeAnalysis": {
      "title": "Resume Analysis",
      "description": "Results of a resume audit.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "filename": { "type": "string" },
        "atsScore": { "type": "number" },
        "targetRole": { "type": "string" },
        "analysis": { "type": "object" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobApplication": {
      "title": "Job Application",
      "description": "A record of a job application submitted by the user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "companyName": { "type": "string" },
        "role": { "type": "string" },
        "location": { "type": "string" },
        "appliedDate": { "type": "string", "format": "date" },
        "link": { "type": "string" },
        "notes": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Applied", "Shortlisted", "Interview Scheduled", "Rejected", "Selected"]
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/entities/UserProfile",
      "description": "Stores user profile and aggregate stats."
    },
    "/users/{userId}/interviews/{interviewId}": {
      "schema": "#/entities/InterviewSession",
      "description": "Stores individual mock interview records."
    },
    "/users/{userId}/daily_challenges/{challengeId}": {
      "schema": "#/entities/DailyChallenge",
      "description": "Stores individual daily challenge records."
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "#/entities/ResumeAnalysis",
      "description": "Stores resume analysis reports."
    },
    "/users/{userId}/job_applications/{applicationId}": {
      "schema": "#/entities/JobApplication",
      "description": "Stores job application tracking data."
    }
  }
}
