rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility function for founder check
    function isFounder() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'founder';
    }

    // Rules for user profile and their private subcollections
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // On create: allow setting the initial profile, but isFreeAccess must be false
      allow create: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.get('isFreeAccess', false) == false;
      
      // On update: allow updates but prevent changing isFreeAccess and other core fields
      allow update: if request.auth != null && request.auth.uid == userId && 
                    request.resource.data.get('isFreeAccess', resource.data.get('isFreeAccess', false)) == resource.data.get('isFreeAccess', false) &&
                    request.resource.data.get('credits', {}) == resource.data.get('credits', {}) &&
                    request.resource.data.get('subscription', {}) == resource.data.get('subscription', {});
      
      match /{allSubcollections=**} {
        allow read, write, list: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Rules for the public feedback collection
    match /userFeedback/{feedbackId} {
      allow read: if (resource.data.status == 'approved' && resource.data.consent == true) || 
                   (request.auth != null && (request.auth.uid == resource.data.userId || isFounder()));
      
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid && 
                      request.resource.data.status == 'pending';
      
      allow update, delete: if isFounder();
    }

    // Master repository for coding questions
    match /codingQuestions/{questionId} {
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      allow write: if isFounder();
    }

    // Global log of AI API usage for cost auditing.
    match /usage_logs/{logId} {
      allow create: if true;
      allow read, list: if true;
    }
  }
}
