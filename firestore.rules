rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility function for founder check
    // Added exists() check to prevent errors if user profile doesn't exist yet
    function isFounder() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'founder';
    }

    // Rules for user profile and their private subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Rules for the public feedback collection
    match /userFeedback/{feedbackId} {
      // Allow public to read approved feedback with consent.
      // Allow owners to read their own pending feedback.
      // Allow founders to read all for moderation.
      allow read: if (resource.data.status == 'approved' && resource.data.consent == true) || 
                   (request.auth != null && (request.auth.uid == resource.data.userId || isFounder()));
      
      // Authenticated users can create their own feedback, but it must be submitted as 'pending'.
      allow create: if request.auth != null && 
                      request.resource.data.userId == request.auth.uid && 
                      request.resource.data.status == 'pending';
      
      // Only founders can update status or delete feedback records.
      allow update, delete: if isFounder();
    }

    // Master repository for coding questions
    match /codingQuestions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isFounder();
    }
  }
}